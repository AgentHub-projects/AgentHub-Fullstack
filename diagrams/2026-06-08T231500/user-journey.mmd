sequenceDiagram
    autonumber
    actor User as "用户"
    participant Frontend as "AgentHub Web端"
    participant Backend as "AgentHub 后端"
    participant Orchestrator as "主Agent Orchestrator"
    participant Worker as "子Agent Worker"

    Note over User,Worker: "=== 用户核心交互流程 ==="

    User->>Frontend: "1. 新建对话"
    Frontend->>Backend: "POST /api/sessions/create"
    Backend-->>Frontend: "Session创建完成"
    Frontend-->>User: "显示新对话窗口"

    User->>Frontend: "2. 输入需求 @选择Agent"
    Note right of User: "例: 帮我写一个React登录页面 @Claude"
    Frontend->>Frontend: "解析@提及 + 附件上传"

    User->>Frontend: "3. 发送消息"
    Frontend->>Backend: "POST /api/sessions/:id/messages"

    Note over Backend: "构建上下文快照"
    Backend->>Backend: "向量检索相关上下文"
    Backend->>Backend: "加载会话记忆"
    Backend->>Backend: "Token预算裁剪"

    Backend->>Orchestrator: "4. ACP session/prompt"
    Note right of Orchestrator: "包含: System层 + Context层 + User请求"

    alt "单Agent模式"
        Orchestrator->>Worker: "分派任务"
        loop "流式产出"
            Worker-->>Orchestrator: "代码/产物 流式返回"
        end
    else "多Agent模式"
        Orchestrator->>Orchestrator: "任务拆解"
        par "并行分派"
            Orchestrator->>Worker: "Agent A: 前端开发"
            Orchestrator->>Worker: "Agent B: 后端接口"
        end
        Worker-->>Orchestrator: "各自产出"
        Orchestrator->>Orchestrator: "聚合结果"
    end

    Orchestrator-->>Backend: "5. ACP session/update (流式)"
    Backend->>Backend: "事件处理 + 实时广播"
    Backend-->>Frontend: "Socket.IO hub:event"

    Frontend->>Frontend: "EventStreamBuffer 构建"
    Frontend-->>User: "6. 实时渲染Agent回复"

    Note over User: "内联展示: 代码Diff + 网页预览卡片 + 文件附件"

    User->>Frontend: "7. 查看/操作产物"
    Frontend-->>User: "展开Inspector面板"
    Note right of User: "代码编辑 / Diff查看 / 预览 / 下载"

    opt "迭代修改"
        User->>Frontend: "8. 继续对话修改"
        Note right of User: "例: 把登录按钮改成蓝色"
        Frontend->>Backend: "发送新消息"
        Backend->>Orchestrator: "带上下文的新Prompt"
        Orchestrator->>Worker: "增量修改任务"
        Worker-->>Frontend: "更新后的代码"
    end

    opt "部署 P2"
        User->>Frontend: "发送部署指令"
        Frontend->>Backend: "触发部署"
        Backend-->>Frontend: "部署状态卡片"
        Frontend-->>User: "预览URL / 部署完成"
    end