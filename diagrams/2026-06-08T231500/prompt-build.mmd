sequenceDiagram
    autonumber
    participant Orch as "Orchestrator"
    participant Context as "HubContextService"
    participant DB as "PostgreSQL"

    Note over Orch,DB: "=== Prompt构建流程 ==="

    Orch->>Orch: "createBootstrapSnapshot() 调用 buildSnapshot()"
    Orch->>Context: "buildSnapshot(sessionId, prompt, mentionedAgents)"
    Context-->>Orch: "HubContextSnapshotDto"

    Orch->>DB: "loadSessionAgentBriefs(sessionId)"
    DB-->>Orch: "参与者Agent列表 (排除orchestrator)"

    Note over Orch: "renderAgentGatewayPrompt()"

    rect rgb(240, 248, 255)
        Orch->>Orch: "构建System层"
        Note right of Orch: "AgentHub 任务分派 (mode)"
        Orch->>Orch: "构建Context层"
        Note right of Orch: "会话上下文(promptText)"
        Orch->>Orch: "构建Agent层"
        Note right of Orch: "提及的Agent + 可用Worker"
        Orch->>Orch: "构建Message层"
        Note right of Orch: "当前用户请求(promptText)"
    end

    Note over Orch: "buildPromptInput() 组装ACP参数"

    Orch->>Orch: "构造 sessionId + prompt[] + _meta"
    Note right of Orch: "_meta: agentId sessionId runId messageId\ncontextSnapshotId mentionedAgentIds"

    Orch-->>Orch: "ACP session/prompt 发送到下游Agent"