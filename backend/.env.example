# =================== 服务端口 ===================
PORT=3001

# =================== 登录鉴权 ===================
# 初始用户由 seed 创建：账号 admin；真实密码只在本地 .env 注入。
AGENTHUB_ADMIN_PASSWORD=change-me
REDIS_URL=redis://localhost:6379

# =================== 数据库 ===================
DATABASE_URL=postgresql://agenthub:agenthub@localhost:5432/agenthub?schema=public


# =================== 下游编排器 ===================
# 必填。下游编排器的 WebSocket 地址。
DOWNSTREAM_ORCHESTRATOR_WS_URL=

# =================== OpenAI / 兼容 API ===================
# 上下文服务用于嵌入检索和摘要
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 可选：OpenAI 兼容的第三方服务（如 DeepSeek、Qwen 等）
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# =================== 摘要模型 ===================
# 可选。不填则回退使用 OPENAI_API_KEY / OPENAI_BASE_URL
SUMMARY_API_KEY=
SUMMARY_BASE_URL=
CONTEXT_SUMMARY_MODEL=deepseek-chat

# =================== 上下文 & 嵌入 ===================
CONTEXT_EMBEDDING_MODEL=text-embedding-3-small
# 可选。上下文窗口 Token 上限（默认 9000）
# CONTEXT_TOKEN_BUDGET=9000
# 可选。近期消息 Token 上限（默认 4800）
# CONTEXT_RECENT_TOKEN_BUDGET=4800
# 可选。最大检索条数（默认 8）
# CONTEXT_RETRIEVAL_LIMIT=8

# =================== 阿里云 OSS（产物存储） ===================
# 可选。如需 OSS 存储产物则填写
ALIYUN_OSS_REGION=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
# 可选。产物的公开 CDN 域名
ALIYUN_OSS_PUBLIC_DOMAIN=
ARTIFACT_OSS_PREFIX=agenthub/artifacts

# =================== Vercel 一键部署（可选） ===================
# 配置后，AgentHub 会自动创建/复用 Vercel Project，并部署到 Production。
VERCEL_TOKEN=
# 可选。部署到团队空间时填写。
VERCEL_TEAM_ID=
# 可选。逗号分隔；只会把这些后端环境变量同步到被部署的 Vercel Project。
VERCEL_DEPLOY_ENV_KEYS=
