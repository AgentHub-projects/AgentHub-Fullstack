# =================== 服务端口 ===================
PORT=3001

# =================== 简单访问鉴权 ===================
# 真实值只放本地 .env，不提交仓库。
AGENTHUB_ACCESS_KEY=change-me

# =================== 数据库 ===================
DATABASE_URL=postgresql://agenthub:agenthub@localhost:5432/agenthub?schema=public


# =================== 下游编排器 ===================
# 可选。留空则使用内置的 Mock Orchestrator。
DOWNSTREAM_ORCHESTRATOR_WS_URL=

# =================== OpenAI / 兼容 API ===================
# 上下文服务用于嵌入检索和摘要
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 可选：OpenAI 兼容的第三方服务（如 DeepSeek、Qwen 等）
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# =================== 摘要模型 ===================
# 可选。不填则回退使用 OPENAI_API_KEY / OPENAI_BASE_URL
SUMMARY_API_KEY=
SUMMARY_BASE_URL=
CONTEXT_SUMMARY_MODEL=deepseek-chat

# =================== 上下文 & 嵌入 ===================
CONTEXT_EMBEDDING_MODEL=text-embedding-3-small
# 可选。上下文窗口 Token 上限（默认 9000）
# CONTEXT_TOKEN_BUDGET=9000
# 可选。近期消息 Token 上限（默认 4800）
# CONTEXT_RECENT_TOKEN_BUDGET=4800
# 可选。最大检索条数（默认 8）
# CONTEXT_RETRIEVAL_LIMIT=8

# =================== 阿里云 OSS（产物存储） ===================
# 可选。如需 OSS 存储产物则填写
ALIYUN_OSS_REGION=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
# 可选。产物的公开 CDN 域名
ALIYUN_OSS_PUBLIC_DOMAIN=
ARTIFACT_OSS_PREFIX=agenthub/artifacts
