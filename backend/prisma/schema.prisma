generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id
  title     String?
  status    String
  agentId   String?
  prompt    String?
  output    String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      AgentRun[]
}

model AgentRun {
  id             String   @id
  sessionId      String
  conversationId String
  agentId        String
  status         String
  prompt         String
  output         Json?
  error          Json?
  createdAt      DateTime @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  session        Session  @relation(fields: [sessionId], references: [id])
  events         AgentEvent[]
}

model AgentEvent {
  eventId        String   @id
  runId          String
  conversationId String
  agentId        String
  type           String
  seq            Int
  payload        Json
  ts             BigInt
  run            AgentRun @relation(fields: [runId], references: [id])
}

model Artifact {
  id        String   @id
  runId     String
  kind      String
  path      String
  createdAt DateTime @default(now())
}

model AgentDefinition {
  id          String   @id
  name        String
  provider    String
  role        String
  description String?
  createdAt   DateTime @default(now())
}

/// Persistent binding from an AgentHub session to a downstream
/// orchestrator session, plus the latest connection state.
model DownstreamSession {
  agentHubSessionId   String   @id
  downstreamSessionId String
  downstreamAgentId   String
  state               String
  lastError           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([downstreamAgentId, downstreamSessionId])
  @@index([downstreamSessionId])
}

/// Tracks downstream session/event ids that have been acked locally,
/// so duplicate deliveries do not produce duplicate AgentEvent rows.
model DownstreamEventAck {
  eventId             String   @id
  agentHubSessionId   String
  downstreamSessionId String
  runId               String
  seq                 Int
  ackedAt             DateTime @default(now())

  @@index([agentHubSessionId])
}
